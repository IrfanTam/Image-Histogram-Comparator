  <property name="styleSheet">
   <string notr="true">/* ============================== */
/* BACKGROUND FORM (Putih bersih) */
QWidget {
    background-color: white;
}

/* ============================== */
/* DEFAULT STYLE UNTUK SEMUA QPushButton */
QPushButton {
    font-weight: bold;
    border: 1px solid #1a5fb4;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #ffffff;
    color: #1a5fb4;
}
QPushButton:hover {
    background-color: #e6f0ff;
}
QPushButton:pressed {
    background-color: #cce0ff;
}

/* ============================== */
/* TOMBOL KHUSUS RGB (DIATUR BERDASARKAN objectName) */

/* Red */
QPushButton#btn_hr {
    background-color: #E53935;
    color: white;
}
QPushButton#btn_hr:hover {
    background-color: #D32F2F;
}
QPushButton#btn_hr:pressed {
    background-color: #B71C1C;
}

/* Green */
QPushButton#btn_hg {
    background-color: #43A047;
    color: white;
}
QPushButton#btn_hg:hover {
    background-color: #388E3C;
}
QPushButton#btn_hg:pressed {
    background-color: #1B5E20;
}

/* Blue */
QPushButton#btn_hb {
    background-color: #1E88E5;
    color: white;
}
QPushButton#btn_hb:hover {
    background-color: #1976D2;
}
QPushButton#btn_hb:pressed {
    background-color: #0D47A1;
}

/* ============================== */
/* QLabel untuk Preview Gambar */
QLabel#label_preview {
    border: 1px solid #999999;
    background-color: #fdfdfd;
}

/* ============================== */
/* QFrame untuk Plot Histogram */
QFrame {
    border: 1px solid #cccccc;
    background-color: #f8f8f8;
    border-radius: 4px;
}
</string>
